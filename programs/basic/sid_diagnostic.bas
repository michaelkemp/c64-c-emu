10 REM SID DIAGNOSTIC -- EACH VOICE X EACH WAVEFORM (INCL. NOISE)
20 POKE 54296,15
30 DIM VB(3): VB(1)=54272: VB(2)=54279: VB(3)=54286
40 DIM WN$(4): WN$(1)="TRIANGLE": WN$(2)="SAWTOOTH": 
45 WN$(3)="PULSE": WN$(4)="NOISE"
50 DIM WV(4): WV(1)=17: WV(2)=33: WV(3)=65: WV(4)=129
60 FOR V=1 TO 3
70 BASE=VB(V)
80 POKE BASE+5,9: POKE BASE+6,241
90 POKE BASE+2,0: POKE BASE+3,8
100 FOR W=1 TO 4
110 PRINT "VOICE";V;WN$(W)
120 CT=WV(W)
130 FOR N=0 TO 7
140 READ F
150 POKE BASE+1,INT(F/256): POKE BASE,F-256*INT(F/256)
160 POKE BASE+4,CT
170 FOR D=1 TO 200: NEXT D
180 POKE BASE+4,CT-1
190 FOR D=1 TO 100: NEXT D
200 NEXT N
210 RESTORE
220 NEXT W
230 NEXT V
240 END
250 DATA 4455,5001,5613,5947,6675,7493,8410,8910
