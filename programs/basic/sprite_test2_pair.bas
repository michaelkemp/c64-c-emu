10 REM SPRITE TEST 2 (PAIR) -- A SIMPLER, EASIER-TO-WATCH VERSION OF
11 REM sprite_test2.bas: JUST 2 ROUND, UNSTRETCHED SPRITES, TO CHECK
12 REM THE BORDER-BOUNCE + BOUNCE-OFF-EACH-OTHER COLLISION MECHANIC
13 REM BEFORE THE FULL 8-SPRITE VERSION'S EXTRA COMPLEXITY.
14 REM STILL COVERS THE FULL PLAYFIELD, INCLUDING X>255 VIA THE $D010
15 REM MSB REGISTER, SAME AS sprite_test2.bas.
19 DIM X(1),Y(1),DX(1),DY(1),FQ(1),BY(2)
20 POKE 54296,15: REM MASTER VOLUME MAX
21 POKE 53280,1: POKE 53281,0: REM WHITE BORDER, BLACK BG
22 PRINT CHR$(147)
30 GOSUB 1000: REM BUILD THE ROUND SPRITE SHAPE
40 GOSUB 2000: REM POSITIONS/COLORS/POINTERS, ENABLE 2 SPRITES
100 GOSUB 3000: REM MOVE + BOUNCE OFF THE BORDER
110 GOSUB 4000: REM HARDWARE COLLISION -> BOUNCE OFF EACH OTHER
120 GOTO 100

1000 REM ---- BUILD A FILLED ROUND DISC AT RNBASE ----
1010 RNBASE=12288
1030 RA=10: CC=11
1040 FOR R=0 TO 20
1050 DR=R-10: HS=RA*RA-DR*DR: HW=INT(SQR(HS)): C1=CC-HW: C2=CC+HW
1060 BY(0)=0: BY(1)=0: BY(2)=0
1070 FOR C=0 TO 23
1080 IF C>=C1 AND C<=C2 THEN BI=INT(C/8):BP=C-8*BI:BY(BI)=BY(BI)+2^(7-BP)
1090 NEXT C
1100 POKE RNBASE+R*3,BY(0): POKE RNBASE+R*3+1,BY(1): POKE RNBASE+R*3+2,BY(2)
1110 NEXT R
1120 RETURN

2000 REM ---- INIT: 2 SPRITES, ROUND, NORMAL SIZE, NO STRETCH ----
2010 FOR N=0 TO 1: READ X(N),Y(N),DX(N),DY(N): NEXT N
2020 FOR N=0 TO 1: READ FQ(N): NEXT N
2030 FOR N=0 TO 1
2040 POKE 2040+N,RNBASE/64
2050 POKE 53287+N,N+1
2060 NEXT N
2070 POKE 53269,3: REM ENABLE SPRITES 0 AND 1 ONLY
2080 POKE 53275,0: POKE 53276,0: POKE 53277,0: POKE 53271,0
2090 RETURN

3000 REM ---- MOVE + BOUNCE OFF THE BORDER, HANDLE X>255 ----
3010 MB=0
3020 FOR N=0 TO 1
3030 X(N)=X(N)+DX(N): Y(N)=Y(N)+DY(N)
3040 XL=24: XH=320: YL=50: YH=230
3050 IF X(N)<XL THEN X(N)=XL: DX(N)=-DX(N): SN=N: GOSUB 5000
3060 IF X(N)>XH THEN X(N)=XH: DX(N)=-DX(N): SN=N: GOSUB 5000
3070 IF Y(N)<YL THEN Y(N)=YL: DY(N)=-DY(N): SN=N: GOSUB 5000
3080 IF Y(N)>YH THEN Y(N)=YH: DY(N)=-DY(N): SN=N: GOSUB 5000
3090 XV=X(N): IF XV>255 THEN XV=XV-256: MB=MB+2^N
3100 POKE 53248+2*N,XV: POKE 53249+2*N,Y(N)
3110 NEXT N
3120 POKE 53264,MB
3130 RETURN

4000 REM ---- COLLISION: WITH ONLY 2 SPRITES, ANY HIT MEANS THESE ----
4001 REM TWO -- NO NEED TO CHECK WHICH BITS $D01E SET.
4005 REM WHILE COOLING DOWN (CD>0) FROM A RECENT BOUNCE, KEEP READING
4006 REM (CLEARING) $D01E BUT IGNORE IT -- A REAL, STALE $D01E READING
4007 REM FROM BEFORE THE BOUNCE TOOK EFFECT CAN OTHERWISE ECHO BACK ONE
4008 REM TICK LATER AS A SPURIOUS SECOND REVERSAL, SENDING THE PAIR
4009 REM BACK INTO EACH OTHER FOREVER -- SEE reference/sprites.md.
4010 IF CD>0 THEN CD=CD-1: CB=PEEK(53278): RETURN
4020 CB=PEEK(53278)
4025 IF CB=0 THEN RETURN
4030 DX(0)=-DX(0): DY(0)=-DY(0): DX(1)=-DX(1): DY(1)=-DY(1)
4040 REM RE-RUN THE MOVE STEP NOW, WITH THE NEW REVERSED DIRECTION, SO
4041 REM THEY ACTUALLY SEPARATE THIS SAME FRAME, THEN HOLD OFF ON THE
4042 REM NEXT REAL COLLISION CHECK FOR A FEW TICKS (CD).
4050 GOSUB 3000
4060 CD=10
4070 SN=0: GOSUB 5000
4080 SN=1: GOSUB 5000
4090 RETURN

5000 REM ---- SHORT TONE FOR SPRITE SN (ITS OWN DEDICATED VOICE) ----
5010 VB=54272+SN*7
5020 POKE VB+1,INT(FQ(SN)/256): POKE VB,FQ(SN)-256*INT(FQ(SN)/256)
5030 POKE VB+5,9: POKE VB+6,0
5040 POKE VB+4,16: POKE VB+4,17
5050 RETURN

9000 REM ---- START X,Y,DX,DY -- FAR APART SO THEY DON'T COLLIDE AT ----
9001 REM FRAME 1 ----
9010 DATA 60,80,3,2
9020 DATA 220,180,-3,-2
9100 REM ---- TONES (FIRST 2 NOTES OF THE SAME 8-NOTE SCALE) ----
9110 DATA 4455,5001
