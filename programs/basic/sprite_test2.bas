10 REM SPRITE TEST 2 -- ALL 8 SPRITES: SQUARE/ROUND SHAPES, NORMAL/X-STRETCH/
11 REM Y-STRETCH/BOTH SIZES, BOUNCING OFF THE REAL BORDER (INCLUDING X>255
12 REM VIA THE $D010 MSB REGISTER, WHITE SO A BORDER HIT IS OBVIOUS
13 REM AGAINST THE BLACK BACKGROUND). A REAL HARDWARE SPRITE-SPRITE
14 REM COLLISION ($D01E) TELEPORTS THE HIT SPRITE TO A NEW RANDOM SPOT
15 REM + VELOCITY (RND()) RATHER THAN JUST REVERSING DIRECTION, WITH A
16 REM SHORT TONE ON EVERY HIT (BORDER OR SPRITE).
17 REM NOTE: REAL BASIC V2 ONLY DISTINGUISHES VARIABLE NAMES BY THEIR FIRST
18 REM 2 CHARACTERS -- EVERY NAME BELOW WAS CHOSEN TO STAY UNIQUE THAT WAY.
19 DIM X(7),Y(7),DX(7),DY(7),W(7),H(7),FQ(7),BY(2),CD(7)
20 POKE 54296,15: REM MASTER VOLUME MAX
21 POKE 53280,1: POKE 53281,0: REM WHITE BORDER, BLACK BG -- BORDER HITS SHOW
22 PRINT CHR$(147)
30 GOSUB 1000: REM BUILD THE SQUARE + ROUND SPRITE SHAPES
40 GOSUB 2000: REM POSITIONS/COLORS/SIZES/POINTERS, ENABLE ALL 8 SPRITES
100 GOSUB 3000: REM MOVE + BOUNCE OFF THE BORDER
110 GOSUB 4000: REM REAL HARDWARE SPRITE-SPRITE COLLISION
120 GOTO 100

1000 REM ---- SHAPES: SQBASE=SQUARE, RNBASE=ROUND DISC ----
1010 SQBASE=12288: RNBASE=12352
1020 FOR I=0 TO 62: POKE SQBASE+I,255: NEXT I
1030 RA=10: CC=11
1040 FOR R=0 TO 20
1050 DR=R-10: HS=RA*RA-DR*DR: HW=INT(SQR(HS)): C1=CC-HW: C2=CC+HW
1060 BY(0)=0: BY(1)=0: BY(2)=0
1070 FOR C=0 TO 23
1080 IF C>=C1 AND C<=C2 THEN BI=INT(C/8):BP=C-8*BI:BY(BI)=BY(BI)+2^(7-BP)
1090 NEXT C
1100 POKE RNBASE+R*3,BY(0): POKE RNBASE+R*3+1,BY(1): POKE RNBASE+R*3+2,BY(2)
1110 NEXT R
1120 RETURN

2000 REM ---- INIT: READ START POS/VEL + NOTES, DERIVE SHAPE/SIZE/COLOR ----
2010 FOR N=0 TO 7: READ X(N),Y(N),DX(N),DY(N): NEXT N
2020 FOR N=0 TO 7: READ FQ(N): NEXT N
2030 XB=0: YB=0
2040 FOR N=0 TO 7
2050 SH=N-2*INT(N/2): REM 0=SQUARE,1=ROUND -- ALTERNATING
2060 XE=INT(N/2)-2*INT(N/4): REM X-STRETCH FLAG -- SPRITES 2,3,6,7
2070 YE=INT(N/4)-2*INT(N/8): REM Y-STRETCH FLAG -- SPRITES 4,5,6,7
2080 W(N)=24+24*XE: H(N)=21+21*YE
2090 XB=XB+XE*2^N: YB=YB+YE*2^N
2100 PT=(SQBASE/64)+SH*((RNBASE/64)-(SQBASE/64))
2110 POKE 2040+N,PT
2120 POKE 53287+N,N+1
2130 NEXT N
2140 POKE 53277,XB: REM X-EXPAND BITMASK
2150 POKE 53271,YB: REM Y-EXPAND BITMASK
2160 POKE 53269,255: REM ENABLE ALL 8 SPRITES
2170 POKE 53275,0: REM SPRITES DRAWN IN FRONT OF BACKGROUND
2180 POKE 53276,0: REM STANDARD (NOT MULTICOLOR) SPRITES
2190 RETURN

3000 REM ---- MOVE ALL SPRITES, BOUNCE OFF THE BORDER, HANDLE X>255 ----
3010 MB=0
3020 FOR N=0 TO 7
3030 X(N)=X(N)+DX(N): Y(N)=Y(N)+DY(N)
3040 XL=24: XH=344-W(N): YL=50: YH=251-H(N)
3050 IF X(N)<XL THEN X(N)=XL: DX(N)=-DX(N): SN=N: GOSUB 5000
3060 IF X(N)>XH THEN X(N)=XH: DX(N)=-DX(N): SN=N: GOSUB 5000
3070 IF Y(N)<YL THEN Y(N)=YL: DY(N)=-DY(N): SN=N: GOSUB 5000
3080 IF Y(N)>YH THEN Y(N)=YH: DY(N)=-DY(N): SN=N: GOSUB 5000
3090 XV=X(N): IF XV>255 THEN XV=XV-256: MB=MB+2^N
3100 POKE 53248+2*N,XV: POKE 53249+2*N,Y(N)
3110 NEXT N
3120 POKE 53264,MB
3130 RETURN

4000 REM ---- SPRITE-SPRITE COLLISION (PEEKING $D01E CLEARS IT) ----
4001 REM PER-SPRITE COOLDOWN (CD()) AFTER A TELEPORT SKIPS A STALE,
4002 REM ALREADY-SUPERSEDED $D01E READING FROM ECHOING BACK AS A
4003 REM SPURIOUS RE-TELEPORT -- SEE reference/sprites.md.
4010 CB=PEEK(53278)
4020 IF CB=0 THEN RETURN
4030 FOR N=0 TO 7
4035 IF CD(N)>0 THEN CD(N)=CD(N)-1: GOTO 4050
4040 IF (CB AND 2^N)<>0 THEN SN=N: GOSUB 6000: GOSUB 5000: CD(N)=10
4050 NEXT N
4060 RETURN

5000 REM ---- TONE FOR SPRITE SN (VOICE=SN MOD 3 -- ONLY 3 REAL VOICES) ----
5010 V=SN-3*INT(SN/3)
5020 VB=54272+V*7
5030 POKE VB+1,INT(FQ(SN)/256): POKE VB,FQ(SN)-256*INT(FQ(SN)/256)
5039 REM ATTACK0/DECAY9, SUSTAIN0 -- FADES OUT ON ITS OWN
5040 POKE VB+5,9: POKE VB+6,0
5049 REM TRIANGLE, GATE OFF THEN ON -- FORCES A FRESH HIT
5050 POKE VB+4,16: POKE VB+4,17
5060 RETURN

6000 REM ---- COLLISION RESPONSE: TELEPORT SPRITE SN SOMEWHERE NEW ----
6001 REM (JUST REVERSING DX/DY LEFT TWO OVERLAPPED SPRITES RE-FLIPPING
6002 REM EACH OTHER EVERY FRAME FOREVER SINCE THEY NEVER ACTUALLY
6003 REM SEPARATED -- A REAL BUG. A FRESH RANDOM SPOT + VELOCITY
6004 REM GUARANTEES SEPARATION AND EXERCISES BASIC'S RND() TOO.
6010 XL=24: XH=344-W(SN): YL=50: YH=251-H(SN)
6020 X(SN)=XL+INT(RND(1)*(XH-XL+1))
6030 Y(SN)=YL+INT(RND(1)*(YH-YL+1))
6040 DX(SN)=INT(RND(1)*6)-3: IF DX(SN)=0 THEN DX(SN)=2
6050 DY(SN)=INT(RND(1)*6)-3: IF DY(SN)=0 THEN DY(SN)=-2
6060 RETURN

9000 REM ---- START X,Y,DX,DY PER SPRITE -- A SPREAD-OUT 4x2 GRID SO NO
9001 REM TWO SPRITES START OVERLAPPING (MAX SPRITE IS 48x42) ----
9010 DATA 40,60,3,2
9020 DATA 110,60,-2,3
9030 DATA 180,60,3,-2
9040 DATA 250,60,-3,2
9050 DATA 40,170,2,-3
9060 DATA 110,170,-3,-2
9070 DATA 180,170,2,3
9080 DATA 250,170,-2,-3
9100 REM ---- PER-SPRITE TONE (SAME SCALE AS THE OTHER 2 .BAS FILES) ----
9110 DATA 4455,5001,5613,5947,6675,7493,8410,8910
