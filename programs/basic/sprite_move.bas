10 REM SPRITE MOVE -- 1 SPRITE, WASD CONTROL (W=UP,A=LEFT,S=DOWN,D=RIGHT)
11 REM MOVES ONE PIXEL PER KEYSTROKE (INCL. THE REAL KERNAL'S OWN KEY
12 REM REPEAT WHILE A KEY IS HELD), CLAMPED TO THE REAL BORDER -- FULL
13 REM WIDTH INCLUDING X>255 VIA THE $D010 MSB REGISTER, STARTS CENTERED.
16 DIM BY(2)
17 POKE 53280,1: POKE 53281,0: REM WHITE BORDER, BLACK BG
18 PRINT CHR$(147)
20 GOSUB 1000: REM BUILD THE SPRITE SHAPE
30 GOSUB 2000: REM POSITION/COLOR/POINTER, ENABLE SPRITE 0
100 GET K$
110 IF K$="W" THEN Y=Y-1
120 IF K$="S" THEN Y=Y+1
130 IF K$="A" THEN X=X-1
140 IF K$="D" THEN X=X+1
150 GOSUB 3000: REM CLAMP TO THE BORDER + POKE POSITION
160 GOTO 100

1000 REM ---- BUILD A FILLED ROUND SPRITE SHAPE AT RNBASE ----
1010 RNBASE=12288
1020 RA=10: CC=11
1030 FOR R=0 TO 20
1040 DR=R-10: HS=RA*RA-DR*DR: HW=INT(SQR(HS)): C1=CC-HW: C2=CC+HW
1050 BY(0)=0: BY(1)=0: BY(2)=0
1060 FOR C=0 TO 23
1070 IF C>=C1 AND C<=C2 THEN BI=INT(C/8):BP=C-8*BI:BY(BI)=BY(BI)+2^(7-BP)
1080 NEXT C
1090 POKE RNBASE+R*3,BY(0): POKE RNBASE+R*3+1,BY(1): POKE RNBASE+R*3+2,BY(2)
1100 NEXT R
1110 RETURN

2000 REM ---- INIT: SPRITE 0, ROUND, WHITE, STARTS CENTERED ----
2010 X=172: Y=140
2020 POKE 2040,RNBASE/64
2030 POKE 53287,1: REM WHITE
2040 POKE 53269,1: REM ENABLE SPRITE 0 ONLY
2050 POKE 53275,0: POKE 53276,0: POKE 53277,0: POKE 53271,0
2060 GOSUB 3000
2070 RETURN

3000 REM ---- CLAMP TO THE BORDER + POKE POSITION (HANDLES X>255) ----
3010 XL=24: XH=320: YL=50: YH=230
3020 IF X<XL THEN X=XL
3030 IF X>XH THEN X=XH
3040 IF Y<YL THEN Y=YL
3050 IF Y>YH THEN Y=YH
3060 XV=X: MB=0: IF XV>255 THEN XV=XV-256: MB=1
3070 POKE 53248,XV: POKE 53249,Y: POKE 53264,MB
3080 RETURN
